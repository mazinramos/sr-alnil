{
  "name": "nile-secrets",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test:unlock": "node --experimental-strip-types scripts/check-unlock.mjs",
    "test:migrate": "node --experimental-strip-types scripts/check-migrate.mjs",
    "test:e2e": "playwright install chromium && node scripts/e2e-playthrough.mjs",
    "test": "npm run test:unlock && npm run test:migrate && npm run test:content",
    "optimize-images": "node scripts/optimize-images.mjs",
    "test:content": "node --experimental-strip-types scripts/check-content.mjs && node --experimental-strip-types scripts/check-content-selftest.mjs",
    "report:assets": "node --experimental-strip-types scripts/report-missing-assets.mjs",
    "thumbs": "node scripts/make-thumbs.mjs"
  },
  "dependencies": {
    "framer-motion": "^14.7.1",
    "lucide-react": "^1.64.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.0",
    "vite": "^6.0.0"
  }
}
